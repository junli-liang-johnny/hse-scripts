PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX phi: <https://hse.ie/ontology/phi#>

# This transformation is no longer needed as phi:memberOfGroup relationships
# are now properly created as IRIs from the indicator_group_members.csv file
# via the IndicatorGroupMembership mapping in config.ttl

# If there are any remaining string literals for phi:memberOfGroup (should not exist),
# this query would clean them up:
DELETE {
  ?indicatorGroup phi:memberOfGroup ?memberStr .
}
WHERE {
  ?indicatorGroup a phi:IndicatorGroup ;
     phi:memberOfGroup ?memberStr .
  FILTER(isLiteral(?memberStr))
}
