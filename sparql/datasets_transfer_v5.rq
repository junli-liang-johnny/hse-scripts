PREFIX dcat: <http://www.w2.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dpv: <https://w3id.org/dpv#>
PREFIX pht: <https://w3id.org/hse/terminology#>

DELETE {
  ?s ?p "dpv:NonPersonalData" .
}
INSERT {
  ?s ?p dpv:NonPersonalData .
}
WHERE {
  ?s ?p "dpv:NonPersonalData" .
};

DELETE {
  ?s ?p "dpv:PseudonymisedData" .
}
INSERT {
  ?s ?p dpv:PseudonymisedData .
}
WHERE {
  ?s ?p "dpv:PseudonymisedData" .
};

DELETE {
  ?dataset dcterms:temporal ?start .
  ?dataset dcterms:temporal ?end .
}
INSERT {
  ?dataset dcterms:temporal ?period .
  ?period a dcterms:PeriodOfTime ;
          dcat:startDate ?start ;
          dcat:endDate ?end .
}
WHERE {
  ?dataset a dcat:Dataset ;
           dcterms:temporal ?start, ?end .
  FILTER(?start < ?end)
  BIND(IRI(CONCAT("https://hse.ie/data/id/", STRUUID())) AS ?period)
};

# replace dcterms:publisher uris
DELETE {
	?s dcterms:publisher ?publisherStr .
} INSERT {
	?s dcterms:publisher ?publisher .
} WHERE {
	?s a dcat:Dataset ;
		dcterms:publisher ?publisherStr .
	
	?publisher a dcterms:Publisher ;
		foaf:name ?publisherStr .
};

# replace dataset distribution uris
DELETE {
	?dataset dcat:distribution ?distributionStr .
} INSERT {
	?dataset dcat:distribution ?distribution .
} WHERE {
	?dataset a dcat:Dataset ;
		dcat:distribution ?distributionStr .

	?distribution a dcat:Distribution ;
		dcterms:format ?distributionStr .
};

# transform dcterms:accrualPeriodicity
DELETE {
  ?s dcterms:accrualPeriodicity ?accrualPeriodicityStr .
} INSERT {
  ?s dcterms:accrualPeriodicity ?accrualPeriodicity .
} WHERE {
  ?s a dcat:Dataset ;
     dcterms:accrualPeriodicity ?accrualPeriodicityStr .

  BIND(
    IF(?accrualPeriodicityStr = "EVERY_2_YEARS", pht:EVERY_2_YEARS, 
      IF(?accrualPeriodicityStr = "EVERY_3_YEARS", pht:EVERY_3_YEARS,
        IF(?accrualPeriodicityStr = "EVERY_4_YEARS", pht:EVERY_4_YEARS,
          IF(?accrualPeriodicityStr = "EVERY_5_YEARS", pht:EVERY_5_YEARS,
            IF(?accrualPeriodicityStr = "ANNUAL", pht:ANNUAL, 
              IF(?accrualPeriodicityStr = "MONTHLY", pht:MONTHLY,
                IF(?accrualPeriodicityStr = "QUARTERLY", pht:QUARTERLY,
                  IF(?accrualPeriodicityStr = "WEEKLY", pht:WEEKLY,
                    IF(?accrualPeriodicityStr = "DAILY", pht:DAILY,
                      IF(?accrualPeriodicityStr = "AS NEEDED", pht:AS_NEEDED,
                        IF(?accrualPeriodicityStr = "NEVER", pht:NEVER, pht:ANNUAL))))))))))
    ) AS ?accrualPeriodicity)
};

# transform phd:spatialAggregation 
DELETE {
  ?s phd:spatialAggregation ?spatialAggregationStr .
} INSERT {
  ?s phd:spatialAggregation ?spatialAggregation .
} WHERE {
  ?s a dcat:Dataset ;
     phd:spatialAggregation ?spatialAggregationStr .

  BIND(IF(?spatialAggregationStr = "National", pht:National, 
      IF(?spatialAggregationStr = "County", pht:County,
        IF(?spatialAggregationStr = "IHA", pht:IHA,
          IF(?spatialAggregationStr = "LAU", pht:LAU,
            IF(?spatialAggregationStr = "LHO", pht:LHO,
              IF(?spatialAggregationStr = "NUTS1", pht:NUTS1,
                IF(?spatialAggregationStr = "NUTS2", pht:NUTS2,
                  IF(?spatialAggregationStr = "NUTS3", pht:NUTS3, pht:National)))))))
    ) AS ?spatialAggregation)
};

# transform dc:spatial
DELETE {
  ?s dc:spatial ?spatialStr .
} INSERT {
  ?s dc:spatial ?spatial .
} WHERE {
  ?s a dcat:Dataset ;
     dc:spatial ?spatialStr .

  BIND(IF(?spatialStr = "Country", pht:Country, 
      IF(?spatialStr = "County", pht:County,
        IF(?spatialStr = "IHA", pht:IHA,
          IF(?spatialStr = "Health region", pht:HealthRegion, pht:Country)))
    ) AS ?spatial)
};