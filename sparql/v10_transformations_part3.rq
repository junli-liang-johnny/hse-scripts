INSERT {
  ?s healthdcatap:healthTheme pht:DEMOGRAPHICS .
} WHERE {
  ?s healthdcatap:healthTheme ?str .
  FILTER(isLiteral(?str) && REGEX(STR(?str), "(^|;\\s*)DEMOGRAPHICS(\\s*;|$)", "i"))
};

INSERT {
  ?s healthdcatap:healthTheme pht:OurPopulation .
} WHERE {
  ?s healthdcatap:healthTheme ?str .
  FILTER(isLiteral(?str) && REGEX(STR(?str), "(^|;\\s*)Our population(\\s*;|$)", "i"))
};

INSERT {
  ?s healthdcatap:healthTheme pht:CONNECTIONS_AND_PARTICIPATION .
} WHERE {
  ?s healthdcatap:healthTheme ?str .
  FILTER(isLiteral(?str) && REGEX(STR(?str), "(^|;\\s*)CONNECTIONS AND PARTICIPATION(\\s*;|$)", "i"))
};

INSERT {
  ?s healthdcatap:healthTheme pht:EDUCATION_AND_SKILLS .
} WHERE {
  ?s healthdcatap:healthTheme ?str .
  FILTER(isLiteral(?str) && REGEX(STR(?str), "(^|;\\s*)EDUCATION( AND SKILLS)?(\\s*;|$)", "i"))
};

INSERT {
  ?s healthdcatap:healthTheme pht:FINANCES .
} WHERE {
  ?s healthdcatap:healthTheme ?str .
  FILTER(isLiteral(?str) && REGEX(STR(?str), "(^|;\\s*)FINANCES(\\s*;|$)", "i"))
};

INSERT {
  ?s healthdcatap:healthTheme pht:HOUSING_AND_ENVIRONMENT .
} WHERE {
  ?s healthdcatap:healthTheme ?str .
  FILTER(isLiteral(?str) && REGEX(STR(?str), "(^|;\\s*)HOUSING AND ENVIRONMENT(\\s*;|$)", "i"))
};

INSERT {
  ?s healthdcatap:healthTheme pht:VULNERABLE_GROUPS .
} WHERE {
  ?s healthdcatap:healthTheme ?str .
  FILTER(isLiteral(?str) && REGEX(STR(?str), "(^|;\\s*)VULNERABLE GROUPS(\\s*;|$)", "i"))
};

INSERT {
  ?s healthdcatap:healthTheme pht:PROVIDING_CARE .
} WHERE {
  ?s healthdcatap:healthTheme ?str .
  FILTER(isLiteral(?str) && REGEX(STR(?str), "(^|;\\s*)PROVIDING CARE(\\s*;|$)", "i"))
};

INSERT {
  ?s healthdcatap:healthTheme pht:DeterminantsOfHealthWellbeing .
} WHERE {
  ?s healthdcatap:healthTheme ?str .
  FILTER(isLiteral(?str) && REGEX(STR(?str), "(^|;\\s*)Determinants of Health", "i"))
};

INSERT {
  ?s healthdcatap:healthTheme pht:OptimisingHealthWellbeing .
} WHERE {
  ?s healthdcatap:healthTheme ?str .
  FILTER(isLiteral(?str) && REGEX(STR(?str), "(^|;\\s*)Optimi(s|z)ing Health", "i"))
};

INSERT {
  ?s healthdcatap:healthTheme pht:UseOfAcuteServices .
} WHERE {
  ?s healthdcatap:healthTheme ?str .
  FILTER(isLiteral(?str) && REGEX(STR(?str), "(^|;\\s*)Use of acute services(\\s*;|$)", "i"))
};

INSERT {
  ?s healthdcatap:healthTheme pht:UseOfCommunityServices .
} WHERE {
  ?s healthdcatap:healthTheme ?str .
  FILTER(isLiteral(?str) && REGEX(STR(?str), "(^|;\\s*)Use of community services(\\s*;|$)", "i"))
