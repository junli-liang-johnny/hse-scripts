  FILTER(isLiteral(?str) && REGEX(STR(?str), "(^|;\\s*)HEALTHCARE AVAILABILITY AND INTEGRATION(\\s*;|$)", "i"))
};

# Note: "SAFETY" has no matching pht: concept. It is dropped here;
# add pht:SAFETY to the terminology to preserve it.
DELETE {
  ?s healthdcatap:healthTheme ?str .
} WHERE {
  ?s healthdcatap:healthTheme ?str .
  FILTER(isLiteral(?str))
}
