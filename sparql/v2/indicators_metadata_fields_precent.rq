PREFIX ddc: <http://purl.org/NET/decimalised#>
PREFIX dpv: <https://w3id.org/dpv#>
PREFIX dcterm: <http://purl.org/dc/terms/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX adms: <http://www.w3.org/ns/adms#>
PREFIX dcterms: <http://purl.org/dc/terms/>
prefix dc: <http://purl.org/dc/elements/1.1/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX : <https://hse.ie/>
PREFIX phi: <https://hse.ie/ontology/phi#>
PREFIX phd: <https://hse.ie/ontology/phd#>
PREFIX healthdcatap: <http://healthdata.dublinked.ie/def/healthdcatap#>

SELECT 
?indicator
?title
?identifierPresent
?accrualPeriodicityPresent
?disaggregationPresent
?numeratorSourcePresent
?denominatorSourcePresent
(
  (
    (IF(?accrualPeriodicityPresent,1,0) +
      IF(?identifierPresent,1,0) +
      IF(?numeratorSourcePresent,1,0) +
      IF(?disaggregationPresent,1,0) +
      IF(?denominatorSourcePresent,1,0)
    ) / 5.0
  ) AS ?percentPresent
)
WHERE {
  ?indicator a phi:Indicator ;
  a dcat:Dataset ;
  dcterms:title ?title .
  OPTIONAL { ?indicator dcterms:accrualPeriodicity ?accrualPeriodicity . }
  OPTIONAL { ?indicator dcterms:identifier ?identifier . }
  OPTIONAL { ?indicator phi:disaggregation ?disaggregation . }
  OPTIONAL { ?indicator phi:numeratorSource ?numeratorSource . }
  OPTIONAL { ?indicator phi:denominatorSource ?denominatorSource . }

  BIND(BOUND(?accrualPeriodicity) AS ?accrualPeriodicityPresent)
  BIND(BOUND(?identifier) AS ?identifierPresent)
  BIND(BOUND(?disaggregation) AS ?disaggregationPresent)
  BIND(BOUND(?numeratorSource) AS ?numeratorSourcePresent)
  BIND(BOUND(?denominatorSource) AS ?denominatorSourcePresent)
}