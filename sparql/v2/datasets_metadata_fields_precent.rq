PREFIX ddc: <http://purl.org/NET/decimalised#>
PREFIX dpv: <https://w3id.org/dpv#>
PREFIX dcterm: <http://purl.org/dc/terms/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX adms: <http://www.w3.org/ns/adms#>
PREFIX dcterms: <http://purl.org/dc/terms/>
prefix dc: <http://purl.org/dc/elements/1.1/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX : <https://hse.ie/>
PREFIX phi: <https://w3id.org/hse/ontology/phi#>
PREFIX phd: <https://w3id.org/hse/ontology/phd#>
PREFIX healthdcatap: <http://healthdata.dublinked.ie/def/healthdcatap#>

SELECT 
?dataset 
?title
?accrualPeriodicityPresent
?temporalResolutionPresent
?accessRightsPresent
?SpatialAggregationCodePresent
?hasPersonalDataPresent
?hasDataControllerPresent
(
  (
    IF(?accrualPeriodicityPresent, 1,0) + 
    IF(?temporalResolutionPresent, 1,0) +
    IF(?accessRightsPresent, 1,0) +
    IF(?SpatialAggregationCodePresent, 1,0) +
    IF(?hasPersonalDataPresent, 1,0) +
    IF(?hasDataControllerPresent, 1,0)
  ) / 6.0 AS ?percent
)
WHERE {
  ?dataset a dcat:Dataset ;
           dcterms:title ?title .
  OPTIONAL { ?dataset dcterms:accrualPeriodicity ?accrualPeriodicity . }
  OPTIONAL { ?dataset dcat:temporalResolution ?temporalResolution . }
  OPTIONAL { ?dataset dcterms:accessRights ?accessRights . }
  OPTIONAL { ?dataset (phd:spatialAggregation | dcat:spatialResolutionInMeters) ?SpatialAggregationCode . }
  ?dataset dpv:hasPersonalData ?hasPersonalData .
  OPTIONAL { ?dataset dpv:hasDataController ?hasDataController . }
  
  BIND(BOUND(?accrualPeriodicity) AS ?accrualPeriodicityPresent)
  BIND(BOUND(?temporalResolution) AS ?temporalResolutionPresent)
  BIND(BOUND(?accessRights) AS ?accessRightsPresent)
  BIND(BOUND(?SpatialAggregationCode) AS ?SpatialAggregationCodePresent)
  BIND(BOUND(?hasPersonalData) AS ?hasPersonalDataPresent)
  BIND(BOUND(?hasDataController) AS ?hasDataControllerPresent)
}