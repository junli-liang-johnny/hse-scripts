@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix vocab: <http://purl.org/vocab/vann/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rmlt: <http://semweb.mmlab.be/ns/rml-target#> .
@prefix formats: <https://www.w3.org/ns/formats/> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rmlpy: <https://rmlpy.com/ontology#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix schema: <http://schema.org/> .
@prefix widoco: <https://w3id.org/widoco/vocab#> .
@prefix sw: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix oahwp: <https://hse-oahwb-profile.adaptcentre.ie#> .
@prefix hwbp: <https://hse-oahwb-profile.adaptcentre.ie#> .
@prefix oahwb: <https://hse-oahwb-profile.adaptcentre.ie#> .
@prefix healthdcatap: <http://healthdata.dublinked.ie/def/healthdcatap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcatap: <https://semiceu.github.io/DCAT-AP/releases/3.0.0/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix : <https://hse-oahwb-profile.adaptcentre.ie#> .

<#Indicator> a rr:TriplesMap ;
	rml:logicalSource [
		rml:source "/home/johnny/workspace/hse/hse-scripts/output_test/indicators_final.csv";
		rml:referenceFormulation ql:CSV ;
	] ;

	rr:subjectMap [
		rr:template "{id}" ;
		rr:class dcat:Dataset ;
		rr:class hwbp:Indicator ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	] ;

	rr:predicateObjectMap [
		rr:predicate dcterms:title ;
		rr:objectMap [
			rml:reference "dcterms:title" ;
			rml:datatype xsd:string ;
		] ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	] ;

	rr:predicateObjectMap [
		rr:predicate dcterms:identifier ;
		rr:objectMap [
			rml:reference "dct:identifier" ;
			rml:datatype xsd:string ;
		] ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	] ;

	rr:predicateObjectMap [
		rr:predicate hwbp:Rationale ;
		rr:objectMap [
			rml:reference "hwbp:Rationale" ;
			rml:datatype xsd:string ;
		] ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	] ;

	rr:predicateObjectMap [
		rr:predicate skos:definition ;
		rr:objectMap [
			rml:reference "skos:definition" ;
			rml:datatype xsd:string ;
		] ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	] ;

	rr:predicateObjectMap [
		rr:predicate hwbp:indicatorType ;
		rr:objectMap [
			rml:reference "hwbp:indicatorType" ;
			rml:datatype xsd:string ;
		] ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	] ;

	rr:predicateObjectMap [
		rr:predicate hwbp:status ;
		rr:objectMap [
			rml:reference "hwbp:status" ;
			rml:datatype xsd:string ;
		] ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	] ;

	rr:predicateObjectMap [
		rr:predicate hwbp:disaggregation ;
		rr:objectMap [
			rml:reference "hwbp:disaggregation" ;
			rml:datatype xsd:string ;
		] ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	] ;

	rr:predicateObjectMap [
		rr:predicate hwbp:numeratorDataElement ;
		rr:objectMap [
			rml:reference "hwbp:numeratorDataElement" ;
			rml:datatype xsd:string ;
		] ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	] ;

	rr:predicateObjectMap [
		rr:predicate hwbp:numeratorSource ;
		rr:objectMap [
			rml:reference "hwbp:numeratorSource [a dct:dataset [a dct:publisher [a dcterms:source]]" ;
			rml:datatype xsd:string ;
		] ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	] ;

	rr:predicateObjectMap [
		rr:predicate hwbp:denominatorDataElement ;
		rr:objectMap [
			rml:reference "hwbp:denominatorDataElement" ;
			rml:datatype xsd:string ;
		] ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	] ;

	rr:predicateObjectMap [
		rr:predicate hwbp:denominatorSource ;
		rr:objectMap [
			rml:reference "hwbp:denominatorSource [a dct:dataset [a dct:publisher [a dcterms:source]]" ;
			rml:datatype xsd:string ;
		] ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	] ;

	rr:predicateObjectMap [
		rr:predicate hwbp:methodology ;
		rr:objectMap [
			rml:reference "hwbp:methodology" ;
			rml:datatype xsd:string ;
		] ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	] ;

	rr:predicateObjectMap [
		rr:predicate dcterms:accrualPeriodicity ;
		rr:objectMap [
			rml:reference "dcterms:accrualPeriodicity" ;
			rml:datatype xsd:string ;
		] ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	] ;

	rr:predicateObjectMap [
		rr:predicate hwbp:reportStyle ;
		rr:objectMap [
			rml:reference "hwbp:reportStyle" ;
			rml:datatype xsd:string ;
		] ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	] ;

	rr:predicateObjectMap [
		rr:predicate healthdcatap:healthTheme ;
		rr:objectMap [
			rml:reference "healthdcatap:healthTheme" ;
			rml:datatype xsd:string ;
		] ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	] ;

	rr:predicateObjectMap [
		rr:predicate hwbp:highLowGuidance ;
		rr:objectMap [
			rml:reference "hwbp:highLowGuidance" ;
			rml:datatype xsd:string ;
		] ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	] ;

	rr:predicateObjectMap [
		rr:predicate hwbp:measurementLimitations ;
		rr:objectMap [
			rml:reference "hwbp:measurementLimitations" ;
			rml:datatype xsd:string ;
		] ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	] ;

	rr:predicateObjectMap [
		rr:predicate hwbp:validityGuidance ;
		rr:objectMap [
			rml:reference "hwbp:validityGuidance" ;
			rml:datatype xsd:string ;
		] ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	] ;

	rr:predicateObjectMap [
		rr:predicate hwbp:importance ;
		rr:objectMap [
			rml:reference "hwbp:importance" ;
			rml:datatype xsd:string ;
		] ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	] ;

	rr:predicateObjectMap [
		rr:predicate dcterms:provenance ;
		rr:objectMap [
			rml:reference "dct:provenance [a dct:ProvenanceStatement;rdfs:label ]" ;
			rml:datatype xsd:string ;
		] ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	] ;

	rr:predicateObjectMap [
		rr:predicate skos:note ;
		rr:objectMap [
			rml:reference "skos:note" ;
			rml:datatype xsd:string ;
		] ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	] ;

	# rr:predicateObjectMap [
	# 	rr:predicate skos:historyNote ;
	# 	rr:objectMap [
	# 		rml:reference "skos:historyNote" ;
	# 		rml:datatype xsd:string ;
	# 	] ;
	# 	rml:logicalTarget <#IndicatorLogicalTarget> ;
	# ]
	.

<#IndicatorPublisher> a rr:TriplesMap ;
	rml:logicalSource [
		rml:source "/home/johnny/workspace/hse/hse-scripts/output_test/indicators_publishers.csv";
		rml:referenceFormulation ql:CSV ;
	] ;

	rr:subjectMap [
		rr:template "{id}" ;
		rr:class dcterms:Publisher ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	] ;

	rr:predicateObjectMap [
		rr:predicate dcterms:source ;
		rr:objectMap [
			rml:reference "dcterms:source" ;
			rml:datatype xsd:string ;
		] ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	]
	.

<#IndicatorProvenance> a rr:TriplesMap ;
	rml:logicalSource [
		rml:source "/home/johnny/workspace/hse/hse-scripts/output_test/indicators_provenance.csv";
		rml:referenceFormulation ql:CSV ;
	] ;

	rr:subjectMap [
		rr:template "{id}" ;
		rr:class dcterms:ProvenanceStatement ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	] ;

	rr:predicateObjectMap [
		rr:predicate rdfs:label ;
		rr:objectMap [
			rml:reference "rdfs:label" ;
			rml:datatype xsd:string ;
		] ;
		rml:logicalTarget <#IndicatorLogicalTarget> ;
	] 
	.

