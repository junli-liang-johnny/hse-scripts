<https://hse-oahwb-profile.adaptcentre.ie/indicator/hse0000001> a dcat:Dataset,
        :Indicator ;
    healthdcatap:healthTheme "DEMOGRAPHICS" ;
    dcterms:identifier "hse0000001" ;
    dcterms:provenance "CSO - Census 2022" ;
    dcterms:title "Number and proportion of population aged 65 years and over" ;
    skos:definition "The total number and percentage of people in the population who are aged 65 years or older." ;
    skos:note "Replaces F1002 as data available by sex, age and small area" ;
    :numeratorSource "https://data.cso.ie/table/SAP2022T1T1ASA" ;
    :status "Include in Delphi" .

<https://hse-oahwb-profile.adaptcentre.ie/indicator/hse0000002> a dcat:Dataset,
        :Indicator ;
    healthdcatap:healthTheme "VULNERABLE GROUPS" ;
    dcterms:identifier "hse0000002" ;
    dcterms:provenance "Department of Government and Housing" ;
    dcterms:title "Number of homeless persons aged 65+" ;
    skos:definition "The number of people aged 65 years and over who are in accomodation designated for the homeless or sleeping rough." ;
    skos:note "Publicly available by region for all adults (vs 65+)" ;
    :numeratorSource "https://www.gov.ie/en/department-of-housing-local-government-and-heritage/collections/homelessness-data/" ;
    :status "Include in Delphi" .

