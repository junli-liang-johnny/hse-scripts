<https://hse-oahwb-profile.adaptcentre.ie/indicator/hse0000004> a dcat:Dataset,
        :Indicator ;
    healthdcatap:healthTheme "HEALTHCARE USE" ;
    dcterms:identifier "hse0000004" ;
    dcterms:provenance "TILDA" ;
    dcterms:title "Percentage of older adults (65+) who are in receipt of home care package" ;
    skos:definition "The percentage of adults aged 65 years or over receiving organised care services in their own home, such as personal care or nursing." ;
    :denominatorDataElement "All respondents aged 65+ who answered question" ;
    :denominatorSource "TILDA Wave 6" ;
    :numeratorSource "TILDA Wave 6" ;
    :status "Include in Delphi" .

<https://hse-oahwb-profile.adaptcentre.ie/indicator/hse0000005> a dcat:Dataset,
        :Indicator ;
    healthdcatap:healthTheme "DEMOGRAPHICS" ;
    dcterms:identifier "hse0000005" ;
    dcterms:provenance "Pobal" ;
    dcterms:title "Deprivation distribution by 8-point Pobal HP index for those aged 65 and over" ;
    skos:definition "How adults aged 65 years and over are spread across different levels of social and economic disadvantage in an area, based on the Pobal HP Deprivation Index.  The Pobal HP Deprivation Index is Ireland's primary social gradient tool.  Based on the latest Census information (in this case Census 2022) it reveals the profile of communities across Ireland. The Pobal HP Deprivation Index uses data from Census 2022, analysing ten measures of an areas levels of disadvantage. These include educational attainment, employment status and the numbers living in individual households." ;
    skos:note "Available at county, ED and small area level" ;
    :numeratorSource "https://www.pobal.ie/pobal-hp-deprivation-index/" ;
    :status "Include in Delphi" .

